// ==========================================
// MỤC ĐÍCH: TỰ ĐỘNG PHÂN BỔ CONTACT CHO AGENT TRÊN PORTAL THEO CƠ CHẾ ROUND-ROBIN
// TRIGGER: Workflow Rules kích hoạt khi Contact mới được tạo hoặc cập nhật trường Store
// YÊU CẦU: Cần tạo một Custom Module phụ trợ gọi là Store Agents (để lưu danh sách 1000 nhân viên bán hàng từ Microsoft Power Pages và số lượt đã nhận khách của họ)
// ==========================================

// 1. LẤY THÔNG TIN STORE TỪ CONTACT HIỆN TẠI
contactStore = ifnull(input.contact_store_field, ""); 

// Kiểm tra nếu Contact không có thông tin Store thì dừng script để tránh lỗi hệ thống
if(contactStore == "")
{
	info "Không tìm thấy thông tin Store trên Contact này.";
	return;
}

// 2. TÌM KIẾM CÁC AGENT THUỘC STORE NÀY TRONG CUSTOM MODULE "STORE_AGENTS"
// Điều kiện lọc: Store trùng khớp và trạng thái Agent đang hoạt động (Active)
searchRecords = zoho.crm.searchRecords("Store_Agents", "(Store:equals:" + contactStore + " and Status:equals:Active)");

// Nếu không tìm thấy Agent nào thuộc Store này, hệ thống sẽ ghi log và dừng lại
if(searchRecords.size() == 0)
{
	info "Không tìm thấy nhân viên bán hàng nào thuộc cửa hàng: " + contactStore;
	return;
}

// 3. THUẬT TOÁN ROUND-ROBIN: TÌM AGENT CÓ SỐ LƯỢT NHẬN KHÁCH ÍT NHẤT
// Khởi tạo các biến để tìm ra Agent tối ưu nhất
selectedAgent = Map();
minLeadsAssigned = 99999999; // Gán một con số lớn làm mốc so sánh ban đầu

for each  agent in searchRecords
{
	// Lấy số lượng khách hàng mà Agent này đã từng được hệ thống phân bổ
	assignedCount = ifnull(agent.get("Assigned_Count"), 0).toNumber();
	
	// Nếu số lượt của Agent này nhỏ hơn mốc hiện tại, chọn Agent này làm người nhận tiếp theo
	if(assignedCount < minLeadsAssigned)
	{
		minLeadsAssigned = assignedCount;
		selectedAgent = agent;
	}
}

// Lấy thông tin định danh (ID và Name) của Agent được chọn sau khi quét qua danh sách
selectedAgentId = selectedAgent.get("id");
selectedAgentName = selectedAgent.get("Name");

// 4. CẬP NHẬT THÔNG TIN AGENT ĐƯỢC CHỌN VÀO CONTACT
// Chúng ta lưu tên/ID Agent vào các custom fields trên Contact để Microsoft Power Pages đồng bộ về
updateContactMap = Map();
updateContactMap.put("Assigned_Portal_Agent_ID", selectedAgentId);
updateContactMap.put("Assigned_Portal_Agent_Name", selectedAgentName);

// Thực thi lệnh cập nhật dữ liệu Contact trong Zoho CRM
updateContactResponse = zoho.crm.updateRecord("Contacts", input.contact_id, updateContactMap);
info "Đã gán Contact cho Agent: " + selectedAgentName;

// 5. CẬP NHẬT LẠI SỐ LƯỢT (ASSIGNED COUNT) CHO AGENT TRONG CUSTOM MODULE
// Tăng số lượt nhận khách của Agent được chọn lên 1 đơn vị để phục vụ cho lượt phân bổ sau
newCount = minLeadsAssigned + 1;
updateAgentMap = Map();
updateAgentMap.put("Assigned_Count", newCount);

// Thực thi lệnh cập nhật lại Custom Module Store Agents
updateAgentResponse = zoho.crm.updateRecord("Store_Agents", selectedAgentId, updateAgentMap);
info "Đã cập nhật số lượt nhận khách mới cho Agent: " + newCount;
